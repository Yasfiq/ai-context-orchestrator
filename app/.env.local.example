# ==============================================================================
# ENVIRONMENT CONFIGURATION - AI Context Orchestrator (Frontend)
# ==============================================================================

# URL ke Cloudflare Worker API
# Lokal: http://localhost:8787
# Production: https://ai-context-orchestrator-api.<subdomain>.workers.dev
WORKER_API_URL=http://localhost:8787

# Shared Secret untuk otentikasi internal ke Worker (Opsional, disarankan di production)
# WORKER_SECRET=your-secure-token-here

# ------------------------------------------------------------------------------
# (Legacy fallback - hanya digunakan jika WORKER_API_URL tidak diisi)
# ------------------------------------------------------------------------------
# LLM_API_KEY=your-api-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o
# LLM_CHAT_MODEL_NAME=gpt-4o-mini
# LLM_DOCUMENT_MODEL_NAME=gpt-4o
# LLM_TWEAK_MODEL_NAME=gpt-4o-mini
