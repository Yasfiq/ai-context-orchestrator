# ==============================================================================
# ENVIRONMENT CONFIGURATION - AI Context Orchestrator
# ==============================================================================

# 1. API KEY
# Masukkan API Key LLM Provider Anda. (Bisa OpenAI, Groq, LiteLLM, dll)
LLM_API_KEY=your-api-key-here

# 2. BASE URL
# Endpoint API yang compatible dengan format OpenAI.
# Contoh OpenAI asli: https://api.openai.com/v1
# Contoh Groq: https://api.groq.com/openai/v1
# Contoh proxy lokal (9router/LM Studio): http://localhost:8000/v1
LLM_BASE_URL=https://api.openai.com/v1

# 3. MODEL NAME
# Nama model yang ingin Anda gunakan.
# Contoh OpenAI: gpt-4o
# Contoh Groq: llama3-70b-8192
# Contoh lokal: gpt-sol-5.6 atau nama model lokal lainnya
LLM_MODEL_NAME=gpt-4o

# Optional: use a faster model for interactive onboarding.
# Falls back to LLM_MODEL_NAME when omitted.
LLM_CHAT_MODEL_NAME=gpt-4o-mini

# Optional: use a higher-quality model for generated documents.
# Falls back to LLM_MODEL_NAME when omitted.
LLM_DOCUMENT_MODEL_NAME=gpt-4o

# Optional: use a responsive editing model for conversational tweaks.
# Falls back to LLM_CHAT_MODEL_NAME when omitted.
LLM_TWEAK_MODEL_NAME=gpt-4o-mini
